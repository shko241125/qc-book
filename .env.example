# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 .gitignore 에 들어 있어 저장소에 올라가지 않는다.
# 값에는 따옴표를 쓰지 않는다(docker run --env-file 은 따옴표를 값의 일부로 넘긴다).
# IBM Quantum: 대시보드에서 만든 API 키와 인스턴스 CRN
QISKIT_IBM_TOKEN=
QISKIT_IBM_INSTANCE=
# AWS Braket: 자격 증명은 aws configure 로 넣는다. 여기에는 리전만(env/run_braket.py 가 읽는다)
AWS_DEFAULT_REGION=us-east-1
